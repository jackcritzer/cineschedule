{
  "info": {
    "name": "CineSchedule v1",
    "_postman_id": "f3a8a7ee-7f4a-45f2-9c9d-000000000001",
    "description": "Stable API for Phase 7. Set {{baseUrl}} and capture {{token}} via /auth/login test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.cineschedule.com/v1" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "url": "{{baseUrl}}/health" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"ok\": true, \"db\": true, \"time\": \"2025-09-12T19:00:00.000Z\" }"
            },
            {
              "name": "500 INTERNAL_ERROR",
              "originalRequest": { "method": "GET", "url": "{{baseUrl}}/health" },
              "status": "Internal Server Error",
              "code": 500,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": { \"code\": \"INTERNAL_ERROR\", \"message\": \"NOW() query returned no rows\" }, \"requestId\": \"req_abc123\" }"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"0123456789x\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/register" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"token\": \"<jwt>\", \"user\": { \"id\": 1, \"email\": \"user@example.com\" } }"
            },
            {
              "name": "409 CONFLICT",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/register" },
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": { \"code\": \"CONFLICT\", \"message\": \"Email is already associated with an account\" }, \"requestId\": \"req_abc123\" }"
            },
            {
              "name": "400 VALIDATION_ERROR",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/register" },
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"Invalid request\", \"details\": { \"issues\": [] } }, \"requestId\": \"req_abc123\" }"
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.token, 'token exists').to.be.a('string').and.not.empty;",
                  "// Save token for the whole collection:",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"0123456789x\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/login" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"token\": \"<jwt>\" }"
            },
            {
              "name": "401 AUTH_INVALID_CREDENTIALS",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/login" },
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": { \"code\": \"AUTH_INVALID_CREDENTIALS\", \"message\": \"Invalid credentials\" }, \"requestId\": \"req_abc123\" }"
            }
          ]
        },
        {
          "name": "POST /auth/change-password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"0123456789x\",\n  \"newPassword\": \"new0123456789x\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] }
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"ok\": true }" },
            { "name": "401 AUTH_INVALID_CREDENTIALS", "status": "Unauthorized", "code": 401, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"error\": { \"code\": \"AUTH_INVALID_CREDENTIALS\", \"message\": \"Old password is incorrect\" }, \"requestId\": \"req_abc123\" }" }
          ]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"ok\": true }" }
          ]
        }
      ]
    },
