          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"items\": [], \"nextCursor\": null }" },
            { "name": "400 VALIDATION_ERROR", "status": "Bad Request", "code": 400, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"Invalid request\" }, \"requestId\": \"req_abc123\" }" }
          ]
        },
        {
          "name": "POST /watchlist/tmdb",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{ \"tmdbId\": 27205, \"type\": \"MOVIE\" }" },
            "url": { "raw": "{{baseUrl}}/watchlist/tmdb", "host": ["{{baseUrl}}"], "path": ["watchlist", "tmdb"] }
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"ok\": true, \"titleId\": 42, \"watchlist\": { \"userId\": 1, \"titleId\": 42 }, \"refresh\": { } }" },
            { "name": "502 TMDB_UPSTREAM_ERROR", "status": "Bad Gateway", "code": 502, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"error\": { \"code\": \"TMDB_UPSTREAM_ERROR\", \"message\": \"TMDB fetch failed\" }, \"requestId\": \"req_abc123\" }" }
          ]
        },
        {
          "name": "POST /watchlist/:titleId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/watchlist/42", "host": ["{{baseUrl}}"], "path": ["watchlist", "42"] }
          },
          "response": [
            { "name": "201 CREATED (first add) or 200 OK (idempotent)", "status": "Created", "code": 201, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"id\": 123, \"userId\": 1, \"titleId\": 42, \"createdAt\": \"...\", \"title\": { } }" },
            { "name": "404 RESOURCE_NOT_FOUND", "status": "Not Found", "code": 404, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"error\": { \"code\": \"RESOURCE_NOT_FOUND\", \"message\": \"Title not found\" }, \"requestId\": \"req_abc123\" }" }
          ]
        },
        {
          "name": "DELETE /watchlist/:watchlistItemId",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/watchlist/123", "host": ["{{baseUrl}}"], "path": ["watchlist", "123"] }
          },
          "response": [
            { "name": "200 OK (idempotent)", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"ok\": true }" },
            { "name": "403 AUTH_FORBIDDEN", "status": "Forbidden", "code": 403, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{ \"error\": { \"code\": \"AUTH_FORBIDDEN\", \"message\": \"Not your watchlist item\" }, \"requestId\": \"req_abc123\" }" }
          ]
        }
      ]
    },
