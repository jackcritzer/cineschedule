########################################
# CineSchedule Environment (example)
########################################

# --- Common ---
TMDB_BEARER=replace-with-tmdb-v4-bearer
JWT_SECRET=replace-with-strong-secret

# --- Local Dev (Option A: Postgres in Docker, API on :3000) ---
# e.g. docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cineschedule postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testdb
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testdb_shadow?schema=public
PORT=3000
NODE_ENV=development

# TMDB
TMDB_API_KEY=supersecretkey
DEFAULT_REGION=US

JWT_KEYS=dev_kid=dev_secret
JWT_CURRENT_KID=dev_kid

# Background refresh controls (keep enabled locally if you want to test)
CRON_ENABLED=1
CRON_SCHEDULE=*/15 * * * *       # every 15 minutes (dev)
CRON_TZ=UTC
REFRESH_CONCURRENCY=3
REFRESH_ON_ADD=1

# Nightly batch (dev-friendly)
NIGHTLY_ENABLED=0
NIGHTLY_SCHEDULE=0 4 * * *
NIGHTLY_TZ=UTC
NIGHTLY_MAX_TITLES=250
NIGHTLY_ONE_SHOT=0

# --- Production (Render) ---
# Render injects PORT and NODE_ENV automatically; set these in Render dashboard:
# NODE_ENV=production
# DATABASE_URL=<your prod db url>
# TMDB_BEARER=<your token>
# JWT_SECRET=<your secret>
# CRON_ENABLED=1
# CRON_SCHEDULE=0 4 * * *       # nightly 04:00 UTC
# CRON_TZ=UTC
# REFRESH_CONCURRENCY=5
# REFRESH_ON_ADD=1
# NIGHTLY_ENABLED=1
# NIGHTLY_SCHEDULE=0 3 * * *
# NIGHTLY_TZ=UTC
# NIGHTLY_MAX_TITLES=500
# NIGHTLY_ONE_SHOT=0
