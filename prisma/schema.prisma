generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TitleType {
  MOVIE
  TV
}

model User {
  id             Int         @id @default(autoincrement())
  email          String      @unique
  passwordHash   String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  watchlistItems Watchlist[]
}

model Title {
  id           Int            @id @default(autoincrement())
  tmdbId       Int
  type         TitleType
  name         String
  releaseDate  DateTime?
  posterPath   String?
  overview     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // When our app successfully resfreshed TMDB data for this title
  lastRefreshedAt DateTime?

  // (mostly used when type = TV)
  networkName     String?   // e.g., HBO / Max (first network)
  status          String?   // e.g., "Returning Series"
  episodeRunTime  Int?      // typical minutes (from details.episode_run_time[0])
  tvRating        String?   // e.g., "TV-14"
  providersJson   Json?     // cached “where to watch” (US flatrate list)
  networksJson    Json?

  watchlist    Watchlist[]
  ReleaseEvent ReleaseEvent[]
  Episode      Episode[]

  @@unique([tmdbId, type])
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  titleId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId]) // a user can only add a title once
  @@index([titleId])          // fast “who follows this title?”
}

/// Calendar models

enum ReleaseType {
  THEATRICAL
  DIGITAL
  STREAMING
  PHYSICAL
}

model ReleaseEvent {
  id        Int         @id @default(autoincrement())
  titleId   Int
  title     Title       @relation(fields: [titleId], references: [id], onDelete: Cascade)
  date      DateTime
  type      ReleaseType
  country   String?     @db.VarChar(2) // ISO-3166-1 alpha-2 (e.g., "US")
  source    String      @default("TMDB")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([titleId, date, type, country])
  @@index([date])
  @@index([titleId, date])
}

/// TV Episodes (future airings)
model Episode {
  id            Int      @id @default(autoincrement())
  titleId       Int
  title         Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  seasonNumber  Int
  episodeNumber Int
  name          String?
  airDate       DateTime
  overview      String?
  source        String   @default("TMDB")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runtimeMin Int?        // per-episode runtime if TMDB has it
  stillPath  String?     // episode still image path

  @@unique([titleId, seasonNumber, episodeNumber])
  @@index([airDate])
  @@index([titleId, airDate]) 
}
